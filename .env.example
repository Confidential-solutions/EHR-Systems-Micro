# EHR Platform — example environment (copy to .env.development and fill real values)
# cp .env.example .env.development
# NEVER commit .env.development or real secrets.

# ─────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ehr_platform
POSTGRES_USER=ehr_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────────────────────────────────────────────────────────────────
# MySQL
# ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=ehr_platform
MYSQL_USER=ehr_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────────────────────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MONGO_DATABASE=ehr_platform

# ─────────────────────────────────────────────────────────────────
# Connection strings (.NET)
# Prefer env vars / User Secrets / Key Vault over committed appsettings
# ─────────────────────────────────────────────────────────────────
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=ehr_platform;Username=ehr_user;Password=CHANGE_ME_STRONG_PASSWORD;Include Error Detail=true
ConnectionStrings__MySQL=Server=mysql;Port=3306;Database=ehr_platform;Uid=ehr_user;Pwd=CHANGE_ME_STRONG_PASSWORD;
ConnectionStrings__MongoDB=mongodb://root:CHANGE_ME_ROOT_PASSWORD@mongodb:27017/ehr_platform?authSource=admin
ConnectionStrings__DefaultConnection=Server=patient-db;Database=EHRPatient;User Id=sa;Password=CHANGE_ME_SA_PASSWORD;Encrypt=true;TrustServerCertificate=true;
ConnectionStrings__Redis=redis:6379,password=CHANGE_ME_REDIS_PASSWORD

# ─────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
EHRCommon__RedisConnectionString=redis:6379,password=CHANGE_ME_REDIS_PASSWORD
EHRCommon__EnableCaching=true

# ─────────────────────────────────────────────────────────────────
# Elasticsearch
# ─────────────────────────────────────────────────────────────────
Elasticsearch__Urls=http://elasticsearch:9200
Elasticsearch__Uri=http://elasticsearch:9200
Elasticsearch__Username=elastic
Elasticsearch__Password=CHANGE_ME_ES_PASSWORD

# ─────────────────────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────────────────────
Kafka__BootstrapServers=kafka:9092
Kafka__Environment=development

# ─────────────────────────────────────────────────────────────────
# JWT — use a strong secret (HS256) OR provide PublicKeyPath (RSA)
# Prefer asymmetric keys in production. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────
Jwt__Secret=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET_KEY!!
Jwt__Issuer=ehr-platform
Jwt__Audience=ehr-api
Jwt__ExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7
Jwt__PublicKeyPath=

# ─────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────
Api__Url=http://localhost:5000
Api__Port=5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ─────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────
Security__EncryptionKey=CHANGE_ME_32_CHARS_MINIMUM_ENCRYPTION!
Security__RequireHttps=false
Security__AllowLocalhost=true
EHRCommon__EnableEncryption=true

# CORS origins (comma-separated). Development example includes Angular default port.
Cors__Origins__0=http://localhost:4200
Cors__Origins__1=http://127.0.0.1:4200

# Gate auto-migrate (Patient service). Prefer CI/Helm job in non-dev.
RUN_MIGRATIONS=true

# ─────────────────────────────────────────────────────────────────
# Grafana (if used locally)
# ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
