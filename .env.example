# EHR Platform — local development template
# Copy to .env.development (gitignored) and replace placeholders.
#   cp .env.example .env.development
#
# NEVER commit real passwords, JWT secrets, or encryption keys.

# PostgreSQL
POSTGRES_DB=ehr_platform
POSTGRES_USER=ehr_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=ehr_platform
MYSQL_USER=ehr_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MONGO_DATABASE=ehr_platform

# Connection strings (.NET)
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=ehr_platform;Username=ehr_user;Password=CHANGE_ME_STRONG_PASSWORD;Include Error Detail=true
ConnectionStrings__MySQL=Server=mysql;Port=3306;Database=ehr_platform;Uid=ehr_user;Pwd=CHANGE_ME_STRONG_PASSWORD;
ConnectionStrings__MongoDB=mongodb://root:CHANGE_ME_ROOT_PASSWORD@mongodb:27017/ehr_platform?authSource=admin

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
ConnectionStrings__Redis=redis:6379,password=CHANGE_ME_REDIS_PASSWORD

# Elasticsearch
Elasticsearch__Urls=http://elasticsearch:9200
Elasticsearch__Username=elastic
Elasticsearch__Password=CHANGE_ME_ES_PASSWORD

# Kafka
Kafka__BootstrapServers=kafka:9092
Kafka__Environment=development

# JWT — generate a long random value for local use
# openssl rand -base64 48
Jwt__Secret=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=ehr-platform
Jwt__Audience=ehr-api
Jwt__ExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# API
Api__Url=http://api-gateway:5000
Api__Port=5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Security
Security__EncryptionKey=CHANGE_ME_ENCRYPTION_KEY_32_CHARS_MIN
Security__RequireHttps=false
Security__AllowLocalhost=true
EHRCommon__EnableEncryption=true

# Grafana (local only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Feature flags
Features__EnableAuditLogging=true
Features__EnableEventSourcing=true
Features__EnableCaching=true
Features__EnableSearch=true
Features__EnableMessaging=true
