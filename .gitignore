# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Build
bin/
obj/
dist/
out/
build/
*.dll
*.exe
*.pdb

# Node/npm
node_modules/
npm-debug.log*
yarn-error.log*
# Do NOT ignore lockfiles — commit package-lock.json / yarn.lock / pnpm-lock.yaml for reproducible installs

# .NET
.vs/
*.user
*.suo
.nuget/

# Environment / secrets (never commit real values)
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.production
.env.staging
.env.*
!.env.example

# Docker
.dockerignore

# Logs
logs/
*.log

# Temporary
temp/
tmp/
*.tmp

# Angular
.angular/
dist/

# Database
*.db
*.sqlite
# Allow SQL migrations in backend/db/migrations/
!backend/db/migrations/
backend/db/migrations/*.sql
!backend/db/migrations/*.sql
backend/db/rollback/

# Secrets (never commit these!)
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
secrets.json
launchSettings.json
**/secrets/
*.pem
*.key
